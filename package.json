{
  "name": "boilerplate-app",
  "private": true,
  "version": "1.0.0",
  "description": "Hypergro self-serve deploy boilerplate — Express+TypeScript backend + Next.js frontend in one container, one public URL.",
  "scripts": {
    "bootstrap": "node scripts/bootstrap-frontend.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cross-env PORT=5000 HOST=127.0.0.1 npm --prefix backend run dev",
    "dev:frontend": "cross-env BACKEND_PORT=5000 npm --prefix frontend run dev",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "logs": "node scripts/logs.mjs",
    "docker:build": "docker build -t boilerplate-app .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env boilerplate-app"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@google-cloud/cloudbuild": "^5.6.0",
    "@google-cloud/logging": "^11.2.3",
    "@google-cloud/run": "^3.3.0",
    "@google-cloud/storage": "^7.21.0",
    "tar": "^7.5.19"
  }
}
