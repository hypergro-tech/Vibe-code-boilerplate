# Root env, used only for LOCAL container runs (docker run --env-file .env).
# In production these are INJECTED by the deploy script — never commit a real .env.

# Public port Next.js listens on (Cloud Run injects PORT=8080).
PORT=8080
# Private loopback port for Express (baked into the frontend proxy at build).
BACKEND_PORT=5000

NODE_ENV=production

# This app's name (lowercase slug) — combined with DB_PREFIX for its database name.
APP_NAME=my-app
# Optional prefix grouping all apps' databases (e.g. db "vibecode-my-app").
DB_PREFIX=vibecode-

# MongoDB base cluster URI (the app selects its own DB via APP_NAME).
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net

# Optional file storage (only if the app uploads files).
# GCS_BUCKET=my-uploads-bucket
# GCS_PROJECT_ID=my-gcp-project
