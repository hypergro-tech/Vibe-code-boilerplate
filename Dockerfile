# syntax=docker/dockerfile:1
#
# ONE image, TWO processes (see server.js):
#   • Next.js frontend — public, on $PORT (Cloud Run gives 8080), binds 0.0.0.0
#   • Express backend  — private, on 127.0.0.1:$BACKEND_PORT (5000)
# The frontend proxies /api/* to the backend, so only one port is ever public.
#
# ⚠️  Do not edit this file in a vibecoded app — it's platform-owned (see .ai/deploy.md).

# ---------- shared base ----------
FROM node:20-slim AS base
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# ---------- 1. build backend (tsc -> dist) ----------
FROM base AS backend-build
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/ ./
RUN npm run build

# ---------- 2. backend production dependencies only ----------
FROM base AS backend-deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

# ---------- 3. build frontend (Next.js standalone) ----------
FROM base AS frontend-build
WORKDIR /app/frontend
# Baked into the routes-manifest at build time — must equal the runtime
# BACKEND_PORT (Next resolves rewrites() at build, not runtime).
ARG BACKEND_PORT=5000
ENV BACKEND_PORT=${BACKEND_PORT}
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---------- 4. runtime: both apps in one small image ----------
FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=8080
ENV BACKEND_PORT=5000

# Backend: compiled JS + prod node_modules + package.json (keeps "type":"module")
COPY --from=backend-build --chown=node:node /app/backend/dist         ./backend/dist
COPY --from=backend-deps  --chown=node:node /app/backend/node_modules ./backend/node_modules
COPY --from=backend-build --chown=node:node /app/backend/package.json ./backend/package.json

# Frontend: standalone server, then static assets + public dir NEXT TO server.js
COPY --from=frontend-build --chown=node:node /app/frontend/.next/standalone ./frontend
COPY --from=frontend-build --chown=node:node /app/frontend/.next/static     ./frontend/.next/static
COPY --from=frontend-build --chown=node:node /app/frontend/public           ./frontend/public

# Process supervisor (runs both, ties their lifecycles together)
COPY --chown=node:node server.js ./server.js

USER node
EXPOSE 8080
CMD ["node", "server.js"]
