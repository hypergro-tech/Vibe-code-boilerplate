# ---------------------------------------------------------------------------
# Backend environment (local dev). Copy to .env and fill in.
#   cp .sample.env .env
# In production these are INJECTED at deploy time — never commit a real .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development

# Port + interface the backend binds. Locally 0.0.0.0:5000 is fine. Inside the
# container the entrypoint injects BACKEND_PORT=5000 and HOST=127.0.0.1 so the
# backend is private (only the Next.js proxy in the same container reaches it).
PORT=5000
HOST=0.0.0.0
# BACKEND_PORT=5000   # set by the container; overrides PORT when present

# This app's name (lowercase slug). Combined with DB_PREFIX to name this app's
# OWN database on the shared cluster.
APP_NAME=my-app
# Optional prefix grouping all apps' databases (e.g. db "vibecode-my-app").
# DB_PREFIX=vibecode-

# Database (required). Base cluster URI — the app selects its DB via APP_NAME.
MONGO_URI=mongodb://127.0.0.1:27017

# CORS — comma-separated origins, or "*" to allow all. In production the browser
# only calls same-origin /api/*, so this can be locked down.
CORS_ORIGIN=*

# Google Cloud Storage (only needed if the app stores files). On Cloud Run the
# runtime service account is used automatically; locally point ADC at a key via
# GOOGLE_APPLICATION_CREDENTIALS.
# GCS_BUCKET=my-uploads-bucket
# GCS_PROJECT_ID=my-gcp-project
