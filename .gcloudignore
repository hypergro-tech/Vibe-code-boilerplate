# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# Keep secrets and heavy/rebuilt artifacts OUT of the upload.
# NOTE: when this file exists gcloud ignores .gitignore, so list everything here.
.git
**/node_modules
**/.next
**/dist
**/.env
**/.env.*
!**/.env.example
**/*.log
frontend-scaffold
.hypergro
.DS_Store
